    local low = UI.text(c.Row, "Minimum", UI.format(minimum), 18, 74, 90, 13, 9, T.Muted, T.Mono)
    local high = UI.text(c.Row, "Maximum", UI.format(maximum), 0, 74, 90, 13, 9, T.Muted, T.Mono)
