test("stable control IDs survive updates and reject duplicates without orphan rows", function()
    local group,owner=section()
    local c=group:AddToggle({Id="engine.enabled",Name="Activar",Default=false})
    assert(type(owner.GetControl)=="function","control registry is missing")
    equal(owner:GetControl("engine.enabled"),c,"ID lookup failed")
    c:Update({Name="Motor",Description="Estado guardado.",Value=true})
    equal(c.Id,"engine.enabled","rename changed ID");equal(c.Name,"Motor","name update failed")
    equal(c:Get(),true,"value update failed")
    local count=#group.Frame:GetChildren()
    local ok=pcall(function()group:AddToggle({Id="engine.enabled",Name="Duplicado"})end)
    equal(ok,false,"duplicate explicit ID was accepted")
    equal(#group.Frame:GetChildren(),count,"duplicate left an orphan row")
end)

test("disabled controls block user activation while programmatic Set stays usable", function()
    local group,owner=section();local calls=0
    local toggle=group:AddToggle({Id="state",Name="Estado",Callback=function()calls+=1 end})
    local button=group:AddButton({Id="action",Name="Acción",Callback=function()calls+=1 end})
    assert(type(toggle.SetEnabled)=="function","enabled API missing")
    owner:FinishEntrance();owner:FinishPages();toggle:SetEnabled(false);button:SetEnabled(false);settle()
    equal(toggle:IsEnabled(),false,"control stayed enabled");equal(button:Press(),false,"disabled action executed")
    local vim=game:GetService("VirtualInputManager")
    local p=toggle.Input.Switch.AbsolutePosition+toggle.Input.Switch.AbsoluteSize/2+game:GetService("GuiService"):GetGuiInset()
    vim:SendMouseMoveEvent(p.X,p.Y,game);vim:SendMouseButtonEvent(p.X,p.Y,0,true,game,0);task.wait(.02);vim:SendMouseButtonEvent(p.X,p.Y,0,false,game,0);settle()
    equal(toggle:Get(),false,"disabled toggle reacted to a click");equal(calls,0,"disabled callbacks fired")
    toggle:Set(true,true);equal(toggle:Get(),true,"disabled control rejected state synchronization")
    toggle:SetEnabled(true);equal(toggle:IsEnabled(),true,"control could not be enabled again")
end)

test("destroyed control releases callbacks, selection, search and registry", function()
    local group,owner=section();local gate=Instance.new("BindableEvent");local resumed=false;local entered=false
    table.insert(cleanups,function()gate:Destroy()end)
    local c=group:AddButton({Id="cancel.work",Name="Trabajo",Callback=function()entered=true;gate.Event:Wait();resumed=true end})
    assert(type(c.Destroy)=="function","control destruction missing")
    c:Press();eventually(function()return entered end);c:Focus();c:Destroy();c:Destroy();gate:Fire();settle()
    equal(resumed,false,"destroyed control callback resumed");equal(owner:GetControl("cancel.work"),nil,"ID remained registered")
    equal(c.Row.Parent,nil,"row stayed mounted");equal(c:Press(),false,"destroyed action executed")
    for _,entry in ipairs(owner.Search:Find("Trabajo"))do assert(entry.Control~=c,"search returned a destroyed control")end
end)

test("window state validates before applying and restores stable IDs after rename", function()
    local group,owner=section();local a=group:AddSlider({Id="amount",Name="Cantidad",Min=0,Max=100,Default=25})
    local b=group:AddToggle({Id="enabled",Name="Activo",Default=true})
    assert(type(owner.GetState)=="function" and type(owner.ApplyState)=="function","state API missing")
    local saved=owner:GetState();a:Set(80,true);b:Set(false,true);a:Update({Name="Nueva etiqueta"})
    assert(owner:ApplyState(saved,{Silent=true}));equal(a:Get(),25);equal(b:Get(),true)
    saved.Controls.enabled.Value="wrong";saved.Controls.amount.Value=99
    equal(owner:ApplyState(saved,{Silent=true}),false,"invalid state was accepted")
    equal(a:Get(),25,"invalid state partially changed values")
end)
